<!DOCTYPE html>
<html lang="{{seo.lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{seo.title}}</title>
<meta name="description" content="{{seo.description}}">
<link rel="canonical" href="{{seo.canonical}}">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="{{seo.themeColor}}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{business.name}}">
<meta property="og:title" content="{{seo.ogTitle}}">
<meta property="og:description" content="{{seo.ogDescription}}">
<meta property="og:url" content="{{seo.canonical}}">
<meta property="og:image" content="{{seo.ogImage}}">
<meta property="og:image:width" content="{{seo.ogImageWidth}}">
<meta property="og:image:height" content="{{seo.ogImageHeight}}">
<meta property="og:locale" content="{{seo.ogLocale}}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{seo.twitterTitle}}">
<meta name="twitter:description" content="{{seo.twitterDescription}}">
<meta name="twitter:image" content="{{seo.twitterImage}}">
<meta name="twitter:image:alt" content="{{seo.twitterImageAlt}}">

<link rel="icon" href="./assets/favicon.ico" sizes="any">
<link rel="icon" href="./assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="./assets/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&amp;family=Jost:wght@300;400;500&amp;display=swap" rel="stylesheet">
<link rel="preload" as="image" href="./assets/hero-poster.jpg" fetchpriority="high">
<link rel="stylesheet" href="./assets/styles.css">

<script type="application/ld+json">
{{{ldJson}}}
</script>
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="site-header">
    <a href="#top" class="brand">
      <img src="./assets/longwood-logo-ink.svg" alt="{{brand.logoAlt}}" class="brand__logo">
      <span class="brand__meta">{{brand.meta}}</span>
    </a>
    <nav class="site-nav">
      {{#each nav.links}}
      <a href="{{href}}" class="nav__link">{{label}}</a>
      {{/each}}
      <a href="{{nav.cta.href}}" class="btn btn--nav">{{nav.cta.label}}</a>
    </nav>
  </header>

  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <div class="hero__media">
      <video autoplay muted loop playsinline preload="metadata" poster="./assets/hero-poster.jpg" class="hero__video">
        <source src="./assets/hero.webm" type="video/webm">
        <source src="./assets/hero.mp4" type="video/mp4">
      </video>
    </div>
    <div class="hero__scrim"></div>
    <div class="hero__content">
      <img src="./assets/longwood-logo-cream.svg" alt="{{hero.logoAlt}}" width="{{hero.logoWidth}}" height="{{hero.logoHeight}}" class="hero__logo">
      <h1 class="visually-hidden">{{hero.heading}}</h1>
      <div class="hero__actions">
        {{#each hero.actions}}
        <a href="{{href}}" class="btn {{class}}">{{label}}</a>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ============ ESTATE STRIP ============ -->
  <section class="estate-strip">
    <p class="estate-strip__eyebrow">{{estateStrip.eyebrow}}</p>
    <p class="estate-strip__lead">{{estateStrip.lead}}</p>
  </section>

  <!-- ============ INTRO STRIP ============ -->
  <section class="intro-strip">
    <p class="intro-strip__eyebrow">{{introStrip.eyebrow}}</p>
    <p class="intro-strip__lead">{{introStrip.lead}}</p>
  </section>

  <!-- ============ THE HOUSE ============ -->
  <section id="house" class="section section--paper2">
    <div class="split-grid">
      <div>
        <p class="kicker">{{house.kicker}}</p>
        <h2 class="heading-xl">{{house.heading}}</h2>
        <p class="body-text">{{house.paragraphs.[0]}}</p>
        <p class="body-text body-text--mb-32">{{house.paragraphs.[1]}}</p>
        <div class="stat-row">
          {{#each house.stats}}
          {{> stat}}
          {{/each}}
        </div>
      </div>
      <div class="tile-grid">
        {{#each house.tiles}}
        {{> tile}}
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ============ THE GROUNDS ============ -->
  <section id="grounds" class="section section--paper">
    <div class="split-grid">
      <div class="tile-grid order-2">
        {{#each grounds.tiles}}
        {{> tile}}
        {{/each}}
      </div>
      <div class="order-1">
        <p class="kicker">{{grounds.kicker}}</p>
        <h2 class="heading-xl">{{grounds.heading}}</h2>
        <p class="body-text">{{grounds.paragraph}}</p>
        <ul class="feature-list">
          {{#each grounds.features}}
          <li class="feature-list__item">{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ WEDDINGS & FUNCTIONS (feature) ============ -->
  <section id="weddings" class="section--dark">
    <div class="container">
      <div class="hero-feature__intro">
        <p class="kicker">{{weddings.kicker}}</p>
        <h2 class="heading-xxl">{{weddings.heading}}</h2>
        <p class="hero-feature__lead">{{weddings.lead}}</p>
      </div>
      <div class="feature-grid">
        {{#each weddings.cards}}
        {{> feature-card}}
        {{/each}}
      </div>
      <div class="hero-feature__cta">
        <a href="{{weddings.cta.href}}" class="btn btn--cream">{{weddings.cta.label}}</a>
        <span class="hero-feature__note">{{weddings.ctaNote}}</span>
      </div>
    </div>
  </section>

  <!-- ============ MEETINGS & CONFERENCES ============ -->
  <section id="conferences" class="section section--paper2">
    <div class="split-grid">
      {{> tile conferences.tile}}
      <div>
        <p class="kicker">{{conferences.kicker}}</p>
        <h2 class="heading-xl">{{conferences.heading}}</h2>
        <p class="body-text">{{conferences.paragraphs.[0]}}</p>
        <p class="body-text body-text--mb-32">{{conferences.paragraphs.[1]}}</p>
        <ul class="feature-list feature-list--mb-32">
          {{#each conferences.features}}
          <li class="feature-list__item">{{this}}</li>
          {{/each}}
        </ul>
        <a href="{{conferences.cta.href}}" class="btn btn--dark">{{conferences.cta.label}}</a>
      </div>
    </div>
  </section>

  <!-- ============ THE REGION ============ -->
  <section id="region" class="section section--paper">
    <div class="container">
      <div class="region__intro">
        <p class="kicker">{{region.kicker}}</p>
        <h2 class="heading-xl">{{region.heading}}</h2>
        <p class="body-text body-text--region">{{region.paragraph}}</p>
      </div>
      <div class="region-stats">
        {{#each region.stats}}
        {{> stat this lg=true}}
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  <section id="gallery" class="section section--paper2">
    <div class="container">
      <div class="gallery__intro">
        <p class="kicker kicker--mb-18">{{gallery.kicker}}</p>
        <h2 class="heading-xl heading-xl--flush">{{gallery.heading}}</h2>
      </div>
      <div class="gallery-grid">
        {{#each gallery.tiles}}
        {{> tile}}
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ============ ENQUIRE / CONTACT ============ -->
  <section id="enquire" class="section section--paper">
    <div class="enquire__wrap">
      <div>
        <p class="kicker">{{enquire.kicker}}</p>
        <h2 class="heading-xl heading-xl--sm">{{enquire.heading}}</h2>
        <p class="enquire__lead">{{enquire.lead}}</p>
        <div class="contact-grid">
          <div>
            <div class="contact__label">Host</div>
            <div class="contact__name">{{enquire.host}}</div>
          </div>
          <div>
            <div class="contact__label">Address</div>
            <div class="contact__value">{{enquire.addressLines.[0]}}<br>{{enquire.addressLines.[1]}}</div>
          </div>
          <div>
            <div class="contact__label">Telephone</div>
            <a href="{{business.telephoneHref}}" class="contact__link">{{business.telephoneDisplay}}</a>
          </div>
          <div>
            <div class="contact__label">Email</div>
            <a href="mailto:{{business.email}}" class="contact__link">{{business.email}}</a>
          </div>
        </div>
        <p class="enquire__note">{{enquire.note}}</p>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="site-footer__top">
      <div>
        <img src="./assets/longwood-logo-cream.svg" alt="{{brand.logoAlt}}" class="site-footer__logo">
        <div class="site-footer__meta">{{footer.meta}}</div>
      </div>
      <div class="site-footer__links">
        {{#each footer.links}}
        <a href="{{href}}" class="footer__link">{{label}}</a>
        {{/each}}
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>{{footer.bottomLeft}}</span>
      <span>{{footer.copyright}}</span>
    </div>
  </footer>

</body>
</html>
